# Copy this file to .env.production and fill in real values
# Then run: docker compose --env-file .env.production up -d

NODE_ENV=production
DATABASE_URL=file:/app/data/delly-gold.db

# Optional. Defaults to ./data next to docker-compose.yml.
# Created and migrated automatically by scripts/ensure-data.sh — no need to set.
# DATA_DIR=/var/delly-gold/data

# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-strong-random-secret

JWT_EXPIRES_IN=7d
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_KAVENEGAR_PUSH_APP_ID=cd80523e-45e9-4622-819e-58987f0c6a77
