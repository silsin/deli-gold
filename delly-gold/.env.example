DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="your-strong-random-secret-here"
JWT_EXPIRES_IN="7d"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Kavenegar SMS OTP — API Key from panel.kavenegar.com (NOT the Web Push App ID)
KAVENEGAR_API_KEY="your-kavenegar-api-key"
# verify/lookup template name (create in panel with %token). Default: verify
KAVENEGAR_OTP_TEMPLATE="verify"
# Sender line for plain sms/send (order status) — e.g. 10004347
KAVENEGAR_SENDER="10004347"
# Set to 1 to force plain sms/send instead of verify/lookup
# KAVENEGAR_OTP_PLAIN_SMS="1"
# KAVENEGAR_SITE_NAME="دلی گلد"

# Kavenegar Web Push (browser notifications — separate from SMS API key)
NEXT_PUBLIC_KAVENEGAR_PUSH_APP_ID="cd80523e-45e9-4622-819e-58987f0c6a77"

# Gapify live chat (optional — prefer Admin → Settings → چت آنلاین)
# NEXT_PUBLIC_GAPIFY_WEBSITE_TOKEN=""
# Hugging Face AI try-on (optional — prefer Admin → Settings → پرو مجازی)
# HUGGINGFACE_API_TOKEN="hf_your_token_here"

# Telegram management bot — simple polling (npm run bot)
TELEGRAM_BOT_TOKEN="8874089567:AAHQ1To8xowMyxetFqdH4C2g8tdXeiX-y7Y"
TELEGRAM_ADMIN_PIN="1234"
# Optional: pre-allow your chat ID (find via @userinfobot), or use /start 1234 once
TELEGRAM_ADMIN_IDS=""
# Only for webhook mode (npm run bot:webhook)
TELEGRAM_WEBHOOK_SECRET=""
